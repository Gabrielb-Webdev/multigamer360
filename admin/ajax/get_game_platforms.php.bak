    foreach ($knownGames as $knownGame => $platforms) {
        if (strpos($normalizedName, $knownGame) !== false) {
            error_log("get_game_platforms.php: Found known game: '$knownGame' -> " . implode(', ', $platforms));
            return $platforms;
        }
    }

    return null;
}

try {
    // Verificar si tenemos información conocida
    $knownPlatforms = getKnownGamePlatforms($gameName);

    if ($knownPlatforms !== null) {
        // Usar información de la base de datos
        echo json_encode([
            'success' => true,
            'platforms' => $knownPlatforms,
            'source' => 'KNOWN_DATABASE',
            'game_name' => $gameName
        ]);
        exit;
    }

    // Si no está en la base de datos, buscar en RAWG
    $searchUrl = 'https://api.rawg.io/api/games?search=' . urlencode($gameName) . '&key=' . urlencode($apiKey);

    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $searchUrl);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    curl_setopt($ch, CURLOPT_TIMEOUT, 10);
    curl_setopt($ch, CURLOPT_USERAGENT, 'MultiGamer360/1.0');

    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($httpCode !== 200 || !$response) {
        throw new Exception('Error al conectar con RAWG API');
    }

    $data = json_decode($response, true);

    if (empty($data['results'])) {
        throw new Exception('No se encontró el juego');
    }

    // Tomar el primer resultado
    $game = $data['results'][0];
    $gameId = $game['id'];

    // Obtener detalles completos
    $detailsUrl = "https://api.rawg.io/api/games/{$gameId}?key=" . urlencode($apiKey);

    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $detailsUrl);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    curl_setopt($ch, CURLOPT_TIMEOUT, 10);
    curl_setopt($ch, CURLOPT_USERAGENT, 'MultiGamer360/1.0');

    $detailsResponse = curl_exec($ch);
    curl_close($ch);

    $gameDetails = json_decode($detailsResponse, true);

    // Extraer plataformas
    $platforms = array_map(function($p) {
        return $p['platform']['name'];
    }, $gameDetails['platforms'] ?? []);

    echo json_encode([
        'success' => true,
        'platforms' => $platforms,
        'source' => 'RAWG',
        'game_name' => $gameName
    ]);

} catch (Exception $e) {
    error_log('get_game_platforms.php Error: ' . $e->getMessage());
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
